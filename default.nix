let
  pins = import ./npins;
  pkgs = import pins.nixpkgs-unstable { };
  inherit (pkgs) lib;

  # Kept out of the repo on purpose: the deploy config is part of the build,
  # not something to hand-edit next to the posts.
  wrangler = pkgs.writeText "wrangler.jsonc" (
    builtins.toJSON {
      name = "blog";
      compatibility_date = "2026-09-11";
      # no "main": assets-only, so requests never start an isolate
      assets = {
        directory = "./public";
        not_found_handling = "404-page";
      };
      routes = [
        {
          pattern = "toniogela.dev";
          custom_domain = true;
        }
      ];
    }
  );

  # Applied by Cloudflare to every static asset response. HSTS is not here:
  # the zone-level setting already sends it, on redirects too.
  #
  # CSP: giscus is the only third party the pages load; youtube/vimeo are there
  # for the embed shortcodes, unused today but one post away from breaking.
  # style-src allows inline for the same reason: the image shortcodes emit
  # style attributes. The speculation rules need their own keyword. The one
  # inline script zola emits (the /page/1 redirect) falls back to its own
  # <noscript> meta refresh, so it needs no exception.
  #
  # immutable: only for files every page references with a content hash
  # (`cachebust=true` or a processed_images filename). favicon.ico stays out,
  # browsers also fetch it unhashed.
  headers = pkgs.writeText "_headers" ''
    /*
      Content-Security-Policy: default-src 'none'; script-src 'self' 'inline-speculation-rules' https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data:; font-src 'self'; connect-src 'self' https://giscus.app; frame-src https://giscus.app https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
      X-Content-Type-Options: nosniff
      Referrer-Policy: same-origin
      X-Frame-Options: SAMEORIGIN
      Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=()
      Cross-Origin-Opener-Policy: same-origin-allow-popups
    /processed_images/*
      Cache-Control: public, max-age=31536000, immutable
    /colors.css
      Cache-Control: public, max-age=31536000, immutable
  '';
in
pkgs.stdenvNoCC.mkDerivation {
  name = "blog";
  # only what zola reads, so README/CI edits don't rebuild the site
  src = lib.fileset.toSource {
    root = ./.;
    fileset = lib.fileset.unions [
      ./config.toml
      ./content
      ./sass
      ./syntaxes
      ./templates
      # generated by zola, never an input
      (lib.fileset.difference ./static (lib.fileset.maybeMissing ./static/processed_images))
    ];
  };
  nativeBuildInputs = [ pkgs.zola ];
  buildPhase = "zola build --output-dir public";
  installPhase = ''
    mkdir -p $out
    cp -r public $out/public
    # cachebusted stylesheet URL changes with every CSS edit: preload it (sent as Early Hints by Cloudflare).
    # crossorigin and integrity must match the <link>'s, or the browser fetches it twice
    css=$(grep -o 'colors\.css?h=[0-9a-f]*' public/index.html | head -1)
    sri=$(grep -o 'sha512-[A-Za-z0-9+/=]*' public/index.html | head -1)
    [ -n "$css" ] && [ -n "$sri" ]
    # own /* block: appending to the file would land under the last rule. Cloudflare merges matching rules
    # posts have no common prefix: hint the giscus preconnect on every page that already carries it
    {
      cat ${headers}
      printf '/*\n  Link: </%s>; rel=preload; as=style; crossorigin; integrity="%s"\n' "$css" "$sri"
      grep -rl --include=index.html 'rel=preconnect' public | sed 's|^public||; s|index\.html$||' | sort \
        | while read -r p; do printf '%s\n  Link: <https://giscus.app>; rel=preconnect; crossorigin\n' "$p"; done
    } > $out/public/_headers
    cp ${wrangler} $out/wrangler.jsonc
  '';
}
