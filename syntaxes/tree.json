{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tree",
  "fileTypes": [
    "tree"
  ],
  "scopeName": "source.tree",
  "patterns": [
    {
      "name": "string.quoted.double",
      "match": "[├|└|─|│]"
    },
    {
      "name": "variable.parameter",
      "match": "^\\.+"
    }
  ]
}